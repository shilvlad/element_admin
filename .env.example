APP_NAME=Synapse User Manager
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
DATABASE_URL=sqlite:///./data/synapse-user-manager.db
MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_SERVER_NAME=matrix.example.org
MATRIX_ADMIN_TOKEN=CHANGE_ME
GLOBAL_ROOM_ID=!CHANGE_ME:matrix.example.org
SMTP_HOST=mail.example.ru
SMTP_PORT=587
SMTP_FROM=matrix@example.ru
SMTP_USER=matrix@example.ru
SMTP_PASSWORD=CHANGE_ME
SMTP_STARTTLS=true
ADMIN_EMAIL=admin@example.ru
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=CHANGE_ME
PASSWORD_ENCRYPTION_KEY=CHANGE_ME

# Attempts per IP: login per minute, registration per hour.
LOGIN_ATTEMPTS=10
REGISTRATION_ATTEMPTS=5
# For a reverse proxy, set its actual trusted source IP(s), including Docker gateway if needed.
FORWARDED_ALLOW_IPS=127.0.0.1
