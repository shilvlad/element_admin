server {
    listen 443 ssl;
    server_name users.chat.iteko.su;
    ssl_certificate /etc/letsencrypt/live/chat.iteko.su/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat.iteko.su/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
